# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
# Optional. Defaults to SQLite at backend/warehouse.db; set a Postgres URL when deployed.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/warehouse
# Optional. Pins the tools' "now" to the time passed to seed-db --as-of.
# WAREHOUSE_AS_OF=2026-06-01T13:00
# Optional. Model for the automatic cycle count investigations (default claude-sonnet-5-5).
# INVESTIGATOR_MODEL=claude-haiku-4-5
